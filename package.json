{
  "name": "hypestamp",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "dev": "wrangler dev -c api/wrangler.jsonc --local --test-scheduled",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "db:migrate:local": "wrangler d1 migrations apply hypestamp --local -c api/wrangler.jsonc",
    "contracts:test": "forge test --root contracts",
    "cre:simulate": "cd cre && cre workflow simulate stamp-workflow --target staging-settings"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
