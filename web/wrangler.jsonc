{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hypestamp-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health"],
  },
  "services": [
    {
      "binding": "API",
      "service": "hypestamp-api",
    },
  ],
  "observability": { "enabled": false },
}
