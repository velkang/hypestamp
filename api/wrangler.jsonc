{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hypestamp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hypestamp",
      "database_id": "2360ebdf-bd42-456a-8812-1bab92028827",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "keep_vars": true,
  "vars": {
    "SEPOLIA_RPC_URL": "https://11155111.rpc.thirdweb.com",
    "LEDGER_ADDRESS": "0xaB3B70984e300f48Cd3523b15170dDe2A6ad0018",
    "LEDGER_START_BLOCK": "11920600",
  },
  "observability": { "enabled": true },
}
